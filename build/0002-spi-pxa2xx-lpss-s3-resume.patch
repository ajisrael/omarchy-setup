diff --git a/drivers/spi/spi-pxa2xx.c b/drivers/spi/spi-pxa2xx.c
index 6291d7c2e06f..d0119c1e2e98 100644
--- a/drivers/spi/spi-pxa2xx.c
+++ b/drivers/spi/spi-pxa2xx.c
@@ -76,6 +76,9 @@ struct chip_data {
 #define LPSS_PRIV_CLOCK_GATE_CLK_CTL_MASK	0x3
 #define LPSS_PRIV_CLOCK_GATE_CLK_CTL_FORCE_ON	0x3
 #define LPSS_PRIV_CLOCK_GATE_CLK_CTL_FORCE_OFF	0x0
+#define LPSS_PRIV_RESETS		0x04
+#define LPSS_PRIV_RESETS_FUNC		0x3
+#define LPSS_PRIV_RESETS_IDMA		BIT(2)
 
 struct lpss_config {
 	/* LPSS offset from drv_data->ioaddr */
@@ -189,6 +192,18 @@ static bool is_lpss_ssp(const struct driver_data *drv_data)
 	}
 }
 
+static bool pxa2xx_spi_need_lpss_restore(const struct driver_data *drv_data)
+{
+	switch (drv_data->ssp_type) {
+	case LPSS_LPT_SSP:
+	case LPSS_BYT_SSP:
+	case LPSS_BSW_SSP:
+		return true;
+	default:
+		return false;
+	}
+}
+
 static bool is_quark_x1000_ssp(const struct driver_data *drv_data)
 {
 	return drv_data->ssp_type == QUARK_X1000_SSP;
@@ -1483,35 +1498,101 @@ static int pxa2xx_spi_suspend(struct device *dev)
 {
 	struct driver_data *drv_data = dev_get_drvdata(dev);
 	struct ssp_device *ssp = drv_data->ssp;
+	bool need_restore = pxa2xx_spi_need_lpss_restore(drv_data);
+	unsigned int i;
 	int status;
 
+	if (need_restore) {
+		status = pm_runtime_resume_and_get(dev);
+		if (status < 0)
+			return status;
+	}
+
 	status = spi_controller_suspend(drv_data->controller);
 	if (status)
-		return status;
+		goto out_put;
 
 	pxa_ssp_disable(ssp);
 
 	if (!pm_runtime_suspended(dev))
 		clk_disable_unprepare(ssp->clk);
 
+	if (need_restore) {
+		/*
+		 * Save the first 6 LPSS private registers (offsets 0x00 to
+		 * 0x14) while the LPSS power domain is still enabled.  They
+		 * are lost when the domain is removed across S3 and must be
+		 * restored in pxa2xx_spi_resume().  Offsets beyond 0x14
+		 * (except CS control at 0x18, re-initialised by
+		 * lpss_ssp_setup()) are reserved on LPT, and writing to
+		 * them triggers a PCIe Completion Timeout.
+		 */
+		for (i = 0; i < ARRAY_SIZE(drv_data->lpss_priv_ctx); i++)
+			drv_data->lpss_priv_ctx[i] =
+				__lpss_ssp_read_priv(drv_data, i * 4);
+	}
+
 	return 0;
+
+out_put:
+	if (need_restore)
+		pm_runtime_put_noidle(dev);
+	return status;
 }
 
 static int pxa2xx_spi_resume(struct device *dev)
 {
 	struct driver_data *drv_data = dev_get_drvdata(dev);
 	struct ssp_device *ssp = drv_data->ssp;
+	bool need_restore = pxa2xx_spi_need_lpss_restore(drv_data);
+	bool clock_running = !pm_runtime_suspended(dev);
+	unsigned int i;
 	int status;
 
 	/* Enable the SSP clock */
-	if (!pm_runtime_suspended(dev)) {
+	if (clock_running) {
 		status = clk_prepare_enable(ssp->clk);
 		if (status)
-			return status;
+			goto out_put;
+	}
+
+	if (need_restore) {
+		/*
+		 * The LPSS power domain is removed across S3, taking the
+		 * private registers with it.  De-assert the functional
+		 * block and IDMA resets first; any MMIO access while the
+		 * block is held in reset causes a PCIe Completion Timeout
+		 * and a watchdog-triggered system reset.
+		 */
+		__lpss_ssp_write_priv(drv_data, LPSS_PRIV_RESETS,
+				      LPSS_PRIV_RESETS_FUNC | LPSS_PRIV_RESETS_IDMA);
+
+		/* Restore the other 5 saved private registers */
+		for (i = 0; i < ARRAY_SIZE(drv_data->lpss_priv_ctx); i++) {
+			if (i == LPSS_PRIV_RESETS / 4)
+				continue;
+			__lpss_ssp_write_priv(drv_data, i * 4,
+					      drv_data->lpss_priv_ctx[i]);
+		}
+
+		/*
+		 * Re-initialise the SW chip-select control register so CS
+		 * starts deasserted (SW_MODE | CS_HIGH) regardless of its
+		 * state at suspend time.  A stale asserted CS corrupts the
+		 * first post-resume SPI transaction.
+		 */
+		lpss_ssp_setup(drv_data);
 	}
 
 	/* Start the queue running */
-	return spi_controller_resume(drv_data->controller);
+	status = spi_controller_resume(drv_data->controller);
+	if (status && clock_running)
+		clk_disable_unprepare(ssp->clk);
+
+out_put:
+	if (need_restore)
+		pm_runtime_put_autosuspend(dev);
+	return status;
 }
 
 static int pxa2xx_spi_runtime_suspend(struct device *dev)
