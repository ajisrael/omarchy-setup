{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "~/examples/**": "allow",
      "/tmp/opencode/**": "allow"
    }
  },
  "mcp": {
    "sonarqube": {
      "type": "remote",
      "url": "http://code-control:4000/mcp",
      "enabled": false,
      "headers": {
        "Authorization": "Bearer {env:SONARQUBE_MCP_TOKEN}"
      }
    },
    "jenkins": {
      "type": "remote",
      "url": "http://code-control:8080/mcp-server/stateless",
      "enabled": false,
      "headers": {
        "Authorization": "{env:JENKINS_MCP_AUTH}"
      }
    },
    "grafana": {
      "type": "remote",
      "url": "http://heimdall:4000/mcp",
      "enabled": false
    },
    "dojo-pro-prod": {
      "type": "remote",
      "url": "http://dojo-prod:8084/mcp",
      "enabled": false,
      "headers": {
        "Authorization": "Bearer {env:DOJO_PRO_PROD_TOKEN}"
      }
    },
    "dojo-pro-preprod": {
      "type": "remote",
      "url": "http://dojo-preprod:8084/mcp",
      "enabled": false,
      "headers": {
        "Authorization": "Bearer {env:DOJO_PRO_PREPROD_TOKEN}"
      }
    },
    "dojo-pro-local": {
      "type": "remote",
      "url": "http://localhost:8084/mcp",
      "enabled": false,
      "headers": {
        "Authorization": "Bearer {env:DOJO_PRO_LOCAL_TOKEN}"
      }
    },
    "structurizr": {
      "type": "remote",
      "url": "http://code-control:4001/mcp",
      "enabled": false
    }
  }
}
